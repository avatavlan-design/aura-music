<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tiny_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- Play/Pause Icon filling the 1x1 area -->
    <ImageButton
        android:id="@+id/widget_btn_play_pause"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_circle_bg"
        android:src="@drawable/ic_widget_play"
        android:scaleType="centerInside"
        android:contentDescription="Play or Pause" />
</FrameLayout>
